#!/usr/bin/env bash
# SaaSAllTheThings pre-push hook · framework-owned: replaced on upgrade.
# `bash tools/setup-clone.sh` installs a small shim in .git/hooks that runs this file.
#
# A prototype is never pushed (.satt/procedures/prototype.md), so a push is refused when it sends a
# prototype's branch (refs/heads/proto/<name>, from this clone or to the remote), or any commit that a
# proto/ branch has and main doesn't, whatever the ref is called: HEAD:x, a hash, proto/x~0:x, or a branch
# made from a prototype's commit. A push that sends commits from a prototype's checkout is refused too, whatever
# the ref: the check there reads the prototype's files, not the commits this push sends. Deleting a ref, on the
# remote or from a prototype, is allowed. Git gives one line per ref on stdin: <local ref> <local sha> <remote
# ref> <remote sha>.
#
# Then a push gets the full tier of the project check (bash tools/check.sh --full --if-changed, so a full pass of
# these files is reused, and a fast one never is), unless every ref it sends is a deletion, there's no
# tools/check.sh, or the commits it sends change only paths the check doesn't count (`bash
# tools/check.sh --unignored` says which: anything but Markdown, Markdown in adr/ and Markdown under [tests]
# full-when count), so a clone without the toolchain can push documentation. When the hook can't tell what a push
# changes, it runs the check. A failure, or a check that can't run, blocks the push. The check reads the working
# tree, and its stdin is /dev/null: git's ref list is this hook's, read below.

# The prototypes' own commits, once per push: reachable from a proto/ branch and not from main.
proto_only=""
if git show-ref --verify --quiet refs/heads/main; then
  proto_only="$(git rev-list --branches='proto/*' --not refs/heads/main 2>/dev/null)"
fi

remote="${1:-}"   # git gives the remote's name, or its URL when the push names one
refused=""
sends=0   # 1 when a ref sends commits, not only a deletion
sending=""   # one line per ref that sends commits: <local sha> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_ref:-}" ] || continue
  [ -z "${local_sha#"${local_sha%%[!0]*}"}" ] && continue   # a deletion: the local hash is all zeros
  sends=1
  sending="$sending$local_sha ${remote_sha:-0}"$'\n'
  case "$local_ref $remote_ref" in
    refs/heads/proto/*|*" refs/heads/proto/"*) refused="$refused$local_ref -> $remote_ref (a proto/ branch)"$'\n'; continue ;;
  esac
  [ -n "$proto_only" ] || continue
  # The commits this ref sends beyond main, against the prototypes' own.
  sent="$(git rev-list "$local_sha" --not refs/heads/main 2>/dev/null)"
  [ -n "$sent" ] || continue
  if { printf '%s\n' "$proto_only"; echo "--"; printf '%s\n' "$sent"; } \
      | awk '$0 == "--" { s = 1; next } !s { p[$0] = 1; next } ($0 in p) { found = 1; exit } END { exit !found }'; then
    refused="$refused$local_ref -> $remote_ref (it carries a prototype's commits)"$'\n'
  fi
done
if [ -n "$refused" ]; then
  echo "pre-push: a prototype is never pushed; push blocked:"
  printf '%s' "$refused" | sed 's/^/  /'
  echo "          Its work reaches main through the harvest (.satt/procedures/prototype.md)."
  exit 1
fi

# A prototype's checkout sends no commits from there (tools/prototype.sh says what one is): the check would read its
# files, not the commits this push sends, so the push is refused, unchecked, and nothing reaches the remote.
if [ "$sends" -eq 1 ] && [ -f tools/prototype.sh ] && bash tools/prototype.sh here >/dev/null 2>&1; then
  echo "pre-push: a push from a prototype is refused; nothing was pushed."
  echo "          This checkout is a prototype: the check reads its files, not the commits this push sends."
  echo "          Push from the main checkout, where the check reads the files the push sends."
  exit 1
fi

# --- the full check ---------------------------------------------------------------------------------
[ "$sends" -eq 1 ] || exit 0
[ -f tools/check.sh ] || exit 0

# The paths the push changes, per ref that sends commits, into $changed. For a remote ref this clone has the commit of: the
# paths that differ between that commit and the local one. For a new remote ref: the paths of the commits that no
# remote-tracking ref of this remote has yet. Renamed paths count by both names. Returns 1 when it can't tell (the
# remote's commit isn't here, no remote-tracking ref to compare with, a git command fails): then the check runs.
changed=""
push_paths() {
  local l_sha r_sha out
  while read -r l_sha r_sha; do
    [ -n "$l_sha" ] || continue
    if [ -z "${r_sha#"${r_sha%%[!0]*}"}" ]; then
      [ -n "$remote" ] && [ -n "$(git for-each-ref --count=1 "refs/remotes/$remote/" 2>/dev/null)" ] || return 1
      out="$(set -o pipefail; git -c core.quotePath=false log -m --format= --name-only --no-renames -z "$l_sha" \
        --not --remotes="$remote" 2>/dev/null | tr '\0' '\n')" || return 1
    else
      out="$(set -o pipefail; git -c core.quotePath=false diff --name-only --no-renames -z "$r_sha" "$l_sha" \
        2>/dev/null | tr '\0' '\n')" || return 1
    fi
    changed="$changed$out"$'\n'
  done <<EOF
$sending
EOF
}
if push_paths; then
  counted="$(printf '%s\n' "$changed" | bash tools/check.sh --unignored 2>/dev/null)" || counted="$changed"
  if [[ $counted != *[![:space:]]* ]]; then
    echo "pre-push: no check runs: the commits it sends change only paths the check doesn't count (such as Markdown)"
    exit 0
  fi
fi

echo "pre-push: running the project check, full tier: a push gets the full check"
bash tools/check.sh --full --if-changed </dev/null
status=$?
[ "$status" -eq 0 ] && exit 0
if [ "$status" -eq 3 ]; then
  echo "pre-push: the check couldn't run (the reason is above), so nothing was pushed."
  echo "          When it ran out of time, run it in the background with a longer limit, 'CHECK_TIMEOUT=<seconds> bash"
  echo "          tools/check.sh --full', and push again once it passes (the push reuses its pass), or raise [tests]"
  echo "          timeout-full in tools/check.cfg. When a tool is missing, run 'bash tools/setup-clone.sh'."
else
  echo "pre-push: the full check fails, so nothing was pushed. Fix what it names ('bash tools/check.sh' runs it"
  echo "          again), then push again."
fi
exit 1
