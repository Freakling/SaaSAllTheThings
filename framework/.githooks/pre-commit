#!/usr/bin/env bash
# SaaSAllTheThings pre-commit hook · framework-owned: replaced on upgrade.
# `bash tools/setup-clone.sh` installs a small hook in .git/hooks that runs this file.
#
# On every commit, whatever is staged, it scans for secrets (the check's secrets rule, run alone as
# `bash tools/check.sh --secrets`), so a token pasted into a page, a script or a record is caught
# before it enters history. A scan that can't run blocks the commit. When the commit stages a path the check
# counts (`bash tools/check.sh --unignored` says which: anything but Markdown, Markdown in adr/, and a path that
# runs the full tier, such as a [tests] full-when folder), it also runs the project check, with --if-changed, in
# the tier `bash tools/check.sh --due` names: the full tier when it's due, the fast tier otherwise, and says which
# and why. A pass of the same files, a builder's for one, is reused, so no second run starts
# (.satt/rules.md › Running the check). The check covers the working tree, so commit what you checked.
#
# In a prototype (a linked worktree on a proto/ branch with PROTOTYPE.md at its root, which is what
# `bash tools/prototype.sh here` says; .satt/procedures/prototype.md), tried outside the loop, the project
# check is skipped and the secrets scan is the only gate. So the scan is never skipped there, and the files it
# reads to excuse or to skip a finding (adr/, tools/check.cfg, check.sh, archcheck.awk, .gitattributes) must be
# main's.

# ls-files also lists a nested repository in an ignored folder (such as a clone) as a
# directory, so keep only the paths that really end in .satt-new.
pending="$(git ls-files -o -i --exclude-standard -- '*.satt-new' 2>/dev/null | grep '\.satt-new$')"
if [ -n "$pending" ]; then
  echo "pre-commit: unmerged SaaSAllTheThings upgrade files (*.satt-new) exist. Merge them, then delete them:"
  printf '%s\n' "$pending" | sed 's/^/  /'
  exit 1
fi

# tools/prototype.sh is the one place that says what a prototype is.
prototype=0
[ -f tools/prototype.sh ] && bash tools/prototype.sh here >/dev/null 2>&1 && prototype=1

[ -f tools/check.sh ] || [ "$prototype" -eq 1 ] || exit 0

# In a prototype the scan is the only gate, and an accepted ADR's exception (adr/), the [scan] skip list
# (tools/check.cfg), the scan's own patterns (tools/check.sh, tools/archcheck.awk) and the attributes that make
# git grep skip a file as binary (.gitattributes, at the root or in any folder) decide what it reports.
# Excusing a finding needs the human (rules.md › Who decides), and a prototype has no review to catch it, so
# those files must be main's where the scan and the commit read them: the index differs from main, the disk
# differs from the index, or a file is untracked (ignored ones too, except .gitattributes files, which npm
# packages ship) blocks the commit. The commit's history doesn't count, so taking main's copy back
# (git checkout refs/heads/main -- <path>) after main moved on clears it.
if [ "$prototype" -eq 1 ]; then
  main_ref=refs/heads/main
  if ! git rev-parse --verify -q "$main_ref" >/dev/null 2>&1; then
    echo "pre-commit: this prototype has no main branch to compare the files the secrets scan reads with; commit blocked."
    exit 1
  fi
  scan_inputs=(adr tools/check.cfg tools/check.sh tools/archcheck.awk .gitattributes ':(glob)**/.gitattributes')
  differing="$(git diff --cached --name-only "$main_ref" -- "${scan_inputs[@]}" 2>&1
    git diff --name-only -- "${scan_inputs[@]}" 2>&1
    git ls-files -o -- adr tools/check.cfg tools/check.sh tools/archcheck.awk 2>&1
    git ls-files -o --exclude-standard -- .gitattributes ':(glob)**/.gitattributes' 2>&1)"
  if [ -n "$differing" ]; then
    echo "pre-commit: what the secrets scan reads differs from main's in this prototype; commit blocked:"
    printf '%s\n' "$differing" | sed 's/^/            /'
    echo "            Excusing a secret, or changing the scan, needs the human, in the main session (rules.md › Who decides)."
    echo "            If main changed one of these since the prototype started, take main's copy: git checkout refs/heads/main -- <path>"
    exit 1
  fi
fi

# The secrets scan doesn't wait for the check: a commit of most Markdown starts no check, and a pass the
# check reuses (--if-changed) never looked at a Markdown file. The scan takes a second.
echo "pre-commit: scanning for secrets"
secrets_out="$(bash tools/check.sh --secrets 2>&1)"
status=$?
if [ "$status" -ne 0 ]; then
  printf '%s\n' "$secrets_out"
  if [ "$status" -eq 1 ]; then
    echo "pre-commit: a secret was found; commit blocked."
  elif [ "$prototype" -eq 1 ]; then
    echo "pre-commit: the secrets scan couldn't run, and in a prototype it is the only gate; commit blocked."
  else
    echo "pre-commit: the secrets scan couldn't run; commit blocked."
  fi
  exit 1
fi

# The staged paths the check counts. Which paths count is tools/check.sh's to say (--unignored, the fingerprint's rule),
# so this hook keeps no copy of it. A check.sh that can't answer leaves every staged path counted, so the check runs and
# says what's wrong. A commit that stages none starts no check.
staged="$(git -c core.quotePath=false diff --cached --name-only -z --diff-filter=ACMRD | tr '\0' '\n')"
counted=""
if [ -n "$staged" ]; then
  counted="$(printf '%s\n' "$staged" | bash tools/check.sh --unignored 2>/dev/null)" || counted="$staged"
fi
[ -n "$counted" ] || exit 0
if [ "$prototype" -eq 1 ]; then
  echo "pre-commit: this checkout is a prototype, so the project check is skipped (the secrets scan still ran)"
  exit 0
fi

due="$(bash tools/check.sh --due 2>/dev/null)"
case "$due" in
  "check: full tier not due: "*) tier=fast; why="the full tier isn't due, ${due#check: full tier not due: }" ;;
  "check: full tier due: "*) tier=full; why="${due#check: full tier due: }" ;;
  *) tier=full; why="'bash tools/check.sh --due' gave no answer" ;;
esac
echo "pre-commit: running the project check, $tier tier: $why"
bash tools/check.sh --"$tier" --if-changed
status=$?
if [ "$status" -eq 3 ]; then
  echo "pre-commit: the check couldn't run (the reason is above), so nothing was committed; the staged changes are as they were."
  echo "            When it ran out of time, run it in the background with a longer limit, 'CHECK_TIMEOUT=<seconds> bash"
  echo "            tools/check.sh --$tier', and commit again once it passes (the commit reuses its pass), or raise [tests]"
  echo "            timeout-$tier in tools/check.cfg. When a tool is missing, run 'bash tools/setup-clone.sh'."
  echo "            If you accept an unverified commit, commit with --no-verify yourself."
  exit 1
elif [ "$status" -ne 0 ]; then
  echo "pre-commit: the check fails; commit blocked."
  exit 1
fi
exit 0
