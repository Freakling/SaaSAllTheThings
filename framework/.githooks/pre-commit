#!/usr/bin/env bash
# SaaSAllTheThings pre-commit hook · framework-owned: replaced on upgrade.
# `bash tools/setup-clone.sh` installs a small hook in .git/hooks that runs this file.
#
# Runs the project check when the commit includes anything but documentation (Markdown outside
# adr/). It checks the working tree, so commit what you checked.

if [ -n "$(git ls-files -o -i --exclude-standard -- '*.satt-new' 2>/dev/null)" ]; then
  echo "pre-commit: unmerged SaaSAllTheThings upgrade files (*.satt-new) exist. Merge them, then delete them:"
  git ls-files -o -i --exclude-standard -- '*.satt-new' | sed 's/^/  /'
  exit 1
fi
[ -f tools/check.sh ] || exit 0

if git -c core.quotePath=false diff --cached --name-only -z --diff-filter=ACMRD | tr '\0' '\n' \
    | awk 'NF && (!/\.md$/ || /^adr\//) { found = 1 } END { exit !found }'; then
  echo "pre-commit: running the project check"
  bash tools/check.sh --if-changed
  status=$?
  if [ "$status" -eq 3 ]; then
    echo "pre-commit: the check couldn't run. Run 'bash tools/setup-clone.sh', or, if you accept an"
    echo "unverified commit, commit with --no-verify yourself."
    exit 1
  elif [ "$status" -ne 0 ]; then
    echo "pre-commit: the check fails; commit blocked."
    exit 1
  fi
fi
exit 0
